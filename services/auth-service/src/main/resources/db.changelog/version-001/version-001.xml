<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="create_table_users" author="alexey">
        <preConditions>
            <not>
                <tableExists tableName="users" schemaName="auth"></tableExists>
            </not>
        </preConditions>
        <sqlFile path="create_table_users.sql" relativeToChangelogFile="true"></sqlFile>
    </changeSet>

    <changeSet id="create_table_user_roles" author="alexey">
        <preConditions>
            <not>
                <tableExists tableName="user_roles" schemaName="auth"></tableExists>
            </not>
        </preConditions>
        <sqlFile path="create_table_user_roles.sql" relativeToChangelogFile="true"></sqlFile>
    </changeSet>

    <changeSet id="create_user_admin" author="alexey">
        <preConditions>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM auth.users
                where email = 'superadmin@marketplace.com'
                  and roles = 'ADMIN';
            </sqlCheck>

        </preConditions>
        <sqlFile path="create_user_admin.sql" relativeToChangelogFile="true"></sqlFile>
    </changeSet>

</databaseChangeLog>